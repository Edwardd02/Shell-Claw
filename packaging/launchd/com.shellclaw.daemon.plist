<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shellclaw.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/shellclaw</string>
        <string>daemon</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SHELLCLAW_SOCKET_PATH</key>
        <string>/Users/PLACEHOLDER_USER/.shellclaw/daemon.sock</string>
        <key>SHELLCLAW_MODEL_PATH</key>
        <string>/opt/homebrew/share/shellclaw/models/qwen2.5-coder-0.5b-instruct-finetuned.gguf</string>
        <key>SHELLCLAW_DATA_DIR</key>
        <string>/Users/PLACEHOLDER_USER/.shellclaw</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/PLACEHOLDER_USER/.shellclaw/daemon.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/PLACEHOLDER_USER/.shellclaw/daemon.stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/PLACEHOLDER_USER</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
