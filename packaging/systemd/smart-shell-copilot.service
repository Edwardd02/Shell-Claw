[Unit]
Description=Smart Shell Copilot Daemon
After=network.target

[Service]
Type=simple
ExecStart=/home/%u/.local/bin/smart-shell-copilot-daemon
Restart=always
RestartSec=5

Environment=SSC_SOCKET_PATH=%h/.smart-shell-copilot/daemon.sock
Environment=SSC_MODEL_PATH=/opt/homebrew/share/smart-shell-copilot/models/qwen3-0.6b-base.gguf
Environment=SSC_DATA_DIR=%h/.smart-shell-copilot

StandardOutput=append:%h/.smart-shell-copilot/daemon.log
StandardError=append:%h/.smart-shell-copilot/daemon.error.log

WorkingDirectory=%h
Nice=10

[Install]
WantedBy=default.target
